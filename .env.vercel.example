# ==================== 数据库 (Turso/libSQL) ====================
# Vercel Serverless 不支持本地 SQLite 文件，需要使用 Turso (libSQL) 云数据库
# 注册地址: https://turso.tech (免费额度: 9GB 存储, 5000 次读/天)
#
# 1. 安装 Turso CLI: brew install tursodatabase/tap/turso
# 2. 创建数据库: turso db create lemonclaw-admin
# 3. 获取数据库 URL: turso db show lemonclaw-admin --url
# 4. 获取认证 Token: turso db tokens create lemonclaw-admin
#
DATABASE_URL="libsql://your-database.turso.io?authToken=your-auth-token"

# ==================== NextAuth.js ====================
AUTH_SECRET="dev-secret-change-in-production"
AUTH_TRUST_HOST="true"
AUTH_URL="https://lemon-claw-admin.vercel.app"
NEXTAUTH_URL="https://lemon-claw-admin.vercel.app"

# ==================== 管理员账户 ====================
ADMIN_EMAIL="admin@local.com"
ADMIN_PASSWORD="admin123"

# ==================== JWT ====================
JWT_SECRET="dev-jwt-secret"

# ==================== 模型 API 密钥加密 ====================
# 必须 32 字符
MODEL_API_KEY_ENCRYPTION_SECRET="37HrRDXVh5RfrSZPpPVUuxDCw5mNtv"

# ==================== OpenAPI 文档 ====================
OPENAPI_SERVER_URL="https://lemon-claw-admin.vercel.app"

# ==================== 腾讯云 COS (可选) ====================
# Skill 包存储，如果不需要上传可以留空
TENCENT_COS_SECRET_ID="your-tencent-cos-secret-id"
TENCENT_COS_SECRET_KEY="your-tencent-cos-secret-key"
TENCENT_COS_BUCKET="your-bucket-name"
TENCENT_COS_REGION="ap-guangzhou"
TENCENT_COS_SKILL_PACKAGE_MAX_MB="100"
